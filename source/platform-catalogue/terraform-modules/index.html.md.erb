---
title: Terraform modules
last_reviewed_on: 2026-08-19
review_in: 6 months
weight: 1
---

# <%= current_page.data.title %>

This list is generated from each module repo's `.hmcts/catalogue.yaml` file. To add or fix an entry, propose a
pull request to that repository rather than editing HMCTS Way - see the
[catalogue schema](/schemas/terraform-module-catalogue.schema.json)
for the fields it accepts.

"Stewarded by" identifies the group best placed to review and support the module. It does not confer exclusive
ownership: platform modules such as Front Door are shared HMCTS assets, and anyone can propose an improvement
through a normal pull request, following the
[pull request standards](/cloud-native-platform/standards/pull-requests.html).

The catalogue shows how each capability is used:

- **Self-service** — your team can include and deploy the module from its own Terraform configuration.
- **Shared platform component** — your team proposes a configuration change through a pull request; the shared platform pipeline deploys it after review.

<%
modules = data.terraform_modules || []
categories = modules.map { |m| m['category'] }.compact.uniq.sort
lifecycles = %w[supported experimental deprecated] & modules.map { |m| m['lifecycle'] }.compact.uniq
consumption_models = %w[self-service contribution-required] & modules.map { |m| m.dig('consumption', 'model') }.compact.uniq
lifecycle_tag_class = {
  'supported' => 'govuk-tag--green',
  'experimental' => '',
  'deprecated' => 'govuk-tag--grey'
}
consumption_labels = {
  'self-service' => 'Self-service',
  'contribution-required' => 'Shared platform component'
}
%>

<% if modules.empty? %>
<p>The catalogue is being populated. Modules appear here automatically once
their repositories publish a <code>.hmcts/catalogue.yaml</code> file and carry
the <code>terraform-module</code> GitHub topic.</p>
<% end %>

<% if categories.any? %>
<div class="catalogue-filters" role="group" aria-label="Filter Terraform modules">
  <div class="catalogue-filters__group">
    <span class="catalogue-filters__label">Category:</span>
    <div class="govuk-button-group">
      <button type="button" class="govuk-button catalogue-filter" data-filter-group="category" data-filter-value="all" aria-pressed="true">All</button>
      <% categories.each do |category| %>
      <button type="button" class="govuk-button govuk-button--secondary catalogue-filter" data-filter-group="category" data-filter-value="<%= category %>" aria-pressed="false"><%= category.capitalize %></button>
      <% end %>
    </div>
  </div>
  <div class="catalogue-filters__group">
    <span class="catalogue-filters__label">How to use it:</span>
    <div class="govuk-button-group">
      <button type="button" class="govuk-button catalogue-filter" data-filter-group="consumption" data-filter-value="all" aria-pressed="true">All</button>
      <% consumption_models.each do |model| %>
      <button type="button" class="govuk-button govuk-button--secondary catalogue-filter" data-filter-group="consumption" data-filter-value="<%= model %>" aria-pressed="false"><%= consumption_labels[model] %></button>
      <% end %>
    </div>
  </div>
  <div class="catalogue-filters__group">
    <span class="catalogue-filters__label">Lifecycle:</span>
    <div class="govuk-button-group">
      <button type="button" class="govuk-button catalogue-filter" data-filter-group="lifecycle" data-filter-value="all" aria-pressed="true">All</button>
      <% lifecycles.each do |lifecycle| %>
      <button type="button" class="govuk-button govuk-button--secondary catalogue-filter" data-filter-group="lifecycle" data-filter-value="<%= lifecycle %>" aria-pressed="false"><%= lifecycle.capitalize %></button>
      <% end %>
    </div>
  </div>
  <p class="catalogue-filters__count" id="catalogue-count"></p>
</div>
<% end %>

<% if modules.any? %>
<div id="catalogue-modules">
<% modules.each do |mod| %>
<% links = mod['links'] || {} %>
<% repository = mod['repository'] || {} %>
<% default_branch = repository['default_branch'] || mod['default_branch'] || 'main' %>
<div class="catalogue-module" data-category="<%= mod['category'] %>" data-lifecycle="<%= mod['lifecycle'] %>" data-consumption="<%= mod.dig('consumption', 'model') %>">
  <h2><%= mod['name'] %></h2>
  <p>
    <strong class="govuk-tag <%= lifecycle_tag_class[mod['lifecycle']] %>"><%= mod['lifecycle'] %></strong>
    <% if mod.dig('consumption', 'model') %><strong class="govuk-tag govuk-tag--blue"><%= consumption_labels[mod['consumption']['model']] %></strong><% end %>
    <% if mod['bootstrap_sample'] %><span class="catalogue-module__sample-note">bootstrap sample - not yet sourced from a repo</span><% end %>
  </p>
  <p><%= mod['description'] %></p>
  <div class="table-container">
    <table>
      <tr><td>Stewarded by</td><td><%= mod['owner'] %></td></tr>
      <tr><td>Category</td><td><%= mod['category'] %></td></tr>
      <% if mod['maturity'] %>
      <tr><td>Maturity</td><td><%= mod['maturity'].capitalize %></td></tr>
      <% end %>
      <% unless mod.dig('platform', 'approved').nil? %>
      <tr><td>Platform approval</td><td><%= mod['platform']['approved'] ? 'Approved' : 'Not approved' %></td></tr>
      <% end %>
      <% if mod.dig('consumption', 'model') %>
      <tr><td>How to use it</td><td><%= consumption_labels[mod['consumption']['model']] %> — deployed by <%= mod['consumption']['deployed_by'] %></td></tr>
      <% end %>
      <% if mod.dig('usage', 'new_deployments') %>
      <tr><td>New deployments</td><td><%= mod['usage']['new_deployments'].capitalize %></td></tr>
      <% end %>
      <% if mod.dig('usage', 'existing_deployments') %>
      <tr><td>Existing deployments</td><td><%= mod['usage']['existing_deployments'].capitalize %></td></tr>
      <% end %>
      <% if mod['supported_environments'] %>
      <tr><td>Supported environments</td><td><%= mod['supported_environments'].join(', ') %></td></tr>
      <% end %>
      <% if mod.dig('version', 'recommended') %>
      <tr><td>Recommended version</td><td><%= mod['version']['recommended'] %></td></tr>
      <% end %>
      <% if mod.dig('terraform', 'minimum_version') %>
      <tr><td>Terraform</td><td>&gt;= <%= mod['terraform']['minimum_version'] %></td></tr>
      <% end %>
      <% (mod['providers'] || {}).each do |provider, constraint| %>
      <% next unless constraint %>
      <tr><td><%= provider %> provider</td><td><%= constraint %></td></tr>
      <% end %>
      <% if mod['lifecycle'] == 'deprecated' && mod['replacement'] %>
      <tr><td>Replacement</td><td><%= mod['replacement'] %></td></tr>
      <% end %>
      <% if mod.dig('support', 'contact') %>
      <tr><td>Support</td><td><%= mod['support']['contact'] %></td></tr>
      <% end %>
    </table>
  </div>
  <p>
    <% parts = [] %>
    <% parts << "<a href=\"#{links['documentation']}\">Documentation</a>" if links['documentation'] %>
    <% parts << "<a href=\"#{links['examples']}\">Examples</a>" if links['examples'] %>
    <% parts << "<a href=\"#{mod['consumption']['contribution_repository']}\">Contribute configuration</a>" if mod.dig('consumption', 'contribution_repository') %>
    <% parts << "<a href=\"#{mod['consumption']['contribution_guidance']}\">Contribution guidance</a>" if mod.dig('consumption', 'contribution_guidance') %>
    <% parts << "<a href=\"#{mod['consumption']['request_guidance']}\">Request guidance</a>" if mod.dig('consumption', 'request_guidance') %>
    <% parts << "<a href=\"#{repository['url']}\">GitHub</a>" if repository['url'] %>
    <% parts << "<a href=\"#{repository['url']}/edit/#{default_branch}/.hmcts/catalogue.yaml\">Contribute</a>" if repository['url'] %>
    <%= parts.join(' | ') %>
  </p>
</div>
<% end %>
<p id="catalogue-empty-state" hidden>No modules match the selected filters.</p>
</div>

<script>
(function () {
  var filterButtons = document.querySelectorAll('.catalogue-filter');
  var moduleCards = document.querySelectorAll('.catalogue-module');
  var emptyState = document.getElementById('catalogue-empty-state');
  var countLabel = document.getElementById('catalogue-count');
  var active = { category: 'all', lifecycle: 'all', consumption: 'all' };

  function apply() {
    var visible = 0;
    moduleCards.forEach(function (card) {
      var matches = (active.category === 'all' || card.dataset.category === active.category) &&
        (active.lifecycle === 'all' || card.dataset.lifecycle === active.lifecycle) &&
        (active.consumption === 'all' || card.dataset.consumption === active.consumption);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    emptyState.hidden = visible !== 0;
    if (countLabel) countLabel.textContent = 'Showing ' + visible + ' of ' + moduleCards.length + ' modules';
  }

  filterButtons.forEach(function (button) {
    button.addEventListener('click', function () {
      var group = button.dataset.filterGroup;
      active[group] = button.dataset.filterValue;
      document.querySelectorAll('.catalogue-filter[data-filter-group="' + group + '"]').forEach(function (groupButton) {
        var isActive = groupButton === button;
        groupButton.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        groupButton.classList.toggle('govuk-button--secondary', !isActive);
      });
      apply();
    });
  });

  apply();
})();
</script>
<% end %>
